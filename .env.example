# ==============================================================================
# MercaStats Self-Hosted (Docker) - Plantilla de variables de entorno
# Copia este archivo a `.env` y sustituye los valores de ejemplo.
# NUNCA subas tu `.env` real al repositorio.
# ==============================================================================

# --- Servidor y zona horaria ---
PORT=8080
HOST=0.0.0.0
TZ=Europe/Madrid
LOG_LEVEL=INFO
# URL pública desde la que accedes a MercaStats (usada para construir GMAIL_REDIRECT_URI por defecto)
BASE_URL=http://localhost:8080

# --- Almacenamiento y carpeta vigilada ---
DATA_DIR=/data
DB_PATH=/data/mercastats.db
INBOX_DIR=/data/inbox
# Intervalo en segundos para escanear /data/inbox (0 desactiva la vigilancia)
INBOX_POLL_SECONDS=30
# Usuario que recibe los PDFs dejados directamente en /data/inbox/*.pdf
INBOX_DEFAULT_USER=admin

# Usuario y grupo dueños de la carpeta de datos (el servidor funciona con ellos)
PUID=1000
PGID=1000

# --- Autenticación: local | proxy | none ---
AUTH_MODE=local

# Solo para AUTH_MODE=local (al primer arranque crea este administrador)
ADMIN_USER=admin
# Solo cuenta en el PRIMER arranque (al crear el usuario). Si está vacía entonces, se genera una
# al azar y aparece en los logs. Después la contraseña se cambia desde la web.
ADMIN_PASSWORD=
# Permite registro público desde la pantalla de login (false recomendado)
ALLOW_REGISTRATION=false
# Activa Secure en la cookie de sesión (pon true si accedes siempre por HTTPS)
COOKIE_SECURE=false
SESSION_TTL_DAYS=30

# Solo para AUTH_MODE=proxy (ej. authentik / Authelia forward auth)
# Una sola cabecera, la que tu proxy sobrescribe siempre
PROXY_USER_HEADER=X-authentik-username
PROXY_EMAIL_HEADER=X-authentik-email
PROXY_NAME_HEADER=X-authentik-name
# IP exacta de tu reverse proxy (no toda la subred Docker). Una entrada inválida impide arrancar.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Sincronización IMAP (opcional, con contraseña de aplicación) ---
# Descomenta para activar la lectura automática de correos con tickets PDF
# IMAP_HOST=imap.gmail.com
# IMAP_SSL=true
# 993 por defecto con IMAP_SSL=true, 143 (STARTTLS obligatorio) con IMAP_SSL=false
# IMAP_PORT=993
# IMAP_USER=tu_correo@gmail.com
# IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Carpeta o etiqueta de Gmail donde están los tickets (etiqueta anidada: Tickets/Mercadona;
# todo el correo: [Gmail]/Todos, o [Gmail]/All Mail si Gmail está en inglés)
# IMAP_FOLDER=INBOX
# IMAP_FROM_FILTER=ticket_digital@mail.mercadona.com
# Intervalo en minutos entre sincronizaciones automáticas (0 = solo manual)
# IMAP_SYNC_INTERVAL_MINUTES=60
# Usuario de MercaStats al que se asignarán los tickets descargados por IMAP
# IMAP_TARGET_USER=admin

# --- Sincronización Gmail OAuth 2.0 (opcional, alternativa a IMAP) ---
# Requiere un cliente OAuth de tipo "Aplicación web" en tu propio proyecto de Google Cloud
# GMAIL_CLIENT_ID=tu-client-id.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=tu-client-secret
# GMAIL_REDIRECT_URI=https://mercastats.tu-dominio.com/api/gmail/oauth/callback
# GMAIL_SYNC_INTERVAL_MINUTES=60
